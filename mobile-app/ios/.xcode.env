# Path to Node.js, used by the React Native build phase in Xcode.
# Xcode does not always see the shell PATH, so fall back to the usual
# install locations. To override, create .xcode.env.local (not committed).
export NODE_BINARY=$(command -v node)
if [ -z "$NODE_BINARY" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$candidate" ]; then export NODE_BINARY="$candidate"; break; fi
  done
fi
